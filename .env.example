# --- Meta ---
PAGE_ID=
PAGE_ACCESS_TOKEN=
META_APP_SECRET=
# Санамсаргүй урт текст (жишээ нь: openssl rand -hex 24). Meta-д webhook бүртгэхдээ ижил утгыг оруулна.
WEBHOOK_VERIFY_TOKEN=
GRAPH_API_VERSION=v26.0

# --- Claude ---
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (хямд) эсвэл claude-sonnet-5-5 (илүү чанартай). Хоёулаа ажиллана.
CLAUDE_MODEL=claude-haiku-5-5

# --- Ботын тохиргоо ---
# false болговол бот хариулахаа зогсооно (код өөрчлөхгүйгээр унтраах товч)
BOT_ENABLED=true
# Заавал биш: lib/knowledge.ts файлын оронд бизнесийн мэдээллийг энд өгч болно
BUSINESS_KNOWLEDGE=

# --- Telegram (ЗААВАЛ) ---
# Утасны дугаартай хүсэлтүүд зөвхөн энд ирнэ. Дутуу бол бот асахгүй.
TELEGRAM_BOT_TOKEN=
# Таны ID, эсвэл ажилтнуудын группын ID (-100... гэж эхэлдэг)
TELEGRAM_CHAT_ID=

# --- Өдрийн шалгалт (ЗААВАЛ) ---
# Санамсаргүй урт текст. Vercel cron энэ утгыг Authorization header-ээр илгээнэ.
CRON_SECRET=
