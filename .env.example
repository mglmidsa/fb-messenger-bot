# Энд жинхэнэ утга бүү бич. Бүх утгыг Vercel → Project → Settings → Environment Variables-д оруулна.

# --- Meta ---
PAGE_ID=
PAGE_ACCESS_TOKEN=
META_APP_SECRET=
# Санамсаргүй урт текст. Meta-д webhook бүртгэхдээ ижил утгыг оруулна.
WEBHOOK_VERIFY_TOKEN=
GRAPH_API_VERSION=v26.0

# --- Claude ---
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (хямд) эсвэл claude-sonnet-5-5 (илүү чанартай)
CLAUDE_MODEL=claude-haiku-5-5

# --- Ботын тохиргоо ---
BOT_ENABLED=true
# Заавал биш: lib/knowledge.ts файлын оронд бизнесийн мэдээллийг энд өгч болно
BUSINESS_KNOWLEDGE=

# --- Telegram (ЗААВАЛ) ---
TELEGRAM_BOT_TOKEN=
# Ажилтнуудын группын ID (-100... гэж эхэлдэг). /api/setup/telegram-аас олно.
TELEGRAM_CHAT_ID=

# --- Redis (ЗААВАЛ) ---
# Vercel → Storage → Upstash Redis-ийг project-д холбоход автоматаар үүснэ.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Шалгалт, админ ---
# Санамсаргүй урт текст. Vercel cron болон /api/health, /api/setup, /api/admin хаягууд ашиглана.
CRON_SECRET=
# true үед /api/admin/* хаягууд ажиллана. Тест дууссаны дараа false болго.
ADMIN_TOOLS=false
